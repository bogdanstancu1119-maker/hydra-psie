{
  "name": "Hydra PSIE — Meta-Megaforma",
  "short_name": "Hydra",
  "description": "Organism digital suveran cu PSIE în ADN",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#22d3ee",
  "orientation": "any",
  "icons": [
    {
      "src": "./ui/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./ui/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["productivity", "utilities", "developer"],
  "lang": "ro"
}
{
  "bootstrap": {
    "entry": "platform-bootstrap.js",
    "auto_detect": true,
    "verify_essentials": true,
    "halt_on_missing_essential": true,
    "log_to_file": false,
    "modes": {
      "standalone": {
        "description": "Server autonom complet",
        "loads": ["data", "core", "server", "agents", "deployment"],
        "skips": ["workers"]
      },
      "edge-assisted": {
        "description": "Server + workers externe",
        "loads": ["data", "core", "server", "agents", "ui", "storage", "deployment", "workers"]
      },
      "client-only": {
        "description": "Doar browser, fără server",
        "loads": ["data", "core", "ui", "storage"],
        "skips": ["server", "agents", "deployment", "workers"]
      }
    }
  }
}
